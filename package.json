{
  "name": "digimon-game8-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Scraper de Digivolutions do Game8 para os dados de Digimon.",
  "scripts": {
    "scrape": "node scrape/src/scrape-digimon.js",
    "cli": "node scrape/src/cli.js",
    "test": "npm run test:all",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "next:dev": "npm --prefix next-app run dev",
    "next:build": "npm --prefix next-app run build",
    "next:start": "npm --prefix next-app run start"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.1"
  }
}